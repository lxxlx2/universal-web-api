# Universal Web API hardened local configuration
# Copy to .env only when you need to override these defaults.

# Service
APP_HOST=127.0.0.1
APP_PORT=8199
APP_DEBUG=false
LOG_LEVEL=INFO

# Local API authentication is optional while bound to 127.0.0.1.
# Codex can use any placeholder API key when AUTH_ENABLED=false.
AUTH_ENABLED=false
AUTH_TOKEN=

# Dashboard
DASHBOARD_ENABLED=true
DASHBOARD_FILE=static/index.html
DASHBOARD_AUTH_ENABLED=false
DASHBOARD_AUTH_TOKEN=

# Browser-facing cross-origin access
CORS_ENABLED=false
CORS_ORIGINS=http://127.0.0.1:8199

# Controlled Chromium
BROWSER_PORT=9222
BROWSER_PROFILE_DIR=chrome_profile
BROWSER_PROFILE_NAME=
BROWSER_MEMORY_SAVER=false
PROFILE_CLEAN_ENABLED=false

# Proxy
PROXY_ENABLED=false
PROXY_ADDRESS=
PROXY_BYPASS=localhost,127.0.0.1,::1

# Supply-chain hardening
AUTO_UPDATE_ENABLED=false
UWAPI_ALLOW_UPSTREAM_AUTO_UPDATE=false
GITHUB_REPO=lumingya/universal-web-api
PIP_MIRROR_URL=https://pypi.org/simple

# Dangerous command-engine capability. Keep disabled.
CMD_ALLOW_UNSAFE_PYTHON_COMMANDS=false

# Restart and recovery features
SCHEDULED_RESTART_ENABLED=false
SCHEDULED_RESTART_INTERVAL_SECONDS=10800
SCHEDULED_RESTART_DRAIN_TIMEOUT_SECONDS=1800
SCHEDULED_RESTART_TAB_STATE_POLICY=preserve
TAB_RECOVERY_ENABLED=false
TAB_RECOVERY_MODEL=gpt-4o
TAB_RECOVERY_MAX_ATTEMPTS=1
TAB_RECOVERY_TIMEOUT_SEC=120
TAB_RECOVERY_WORKER_EXIT_WAIT_SEC=600
TAB_RECOVERY_REFRESH_ON_UNKNOWN=true

# Optional helper model
HELPER_API_KEY=
HELPER_BASE_URL=
HELPER_API_PROVIDER=auto
HELPER_MODEL=gemini-3.0-pro
MAX_HTML_CHARS=120000
CANVAS_IMAGE_MAX_SIZE=1024

SITES_CONFIG_FILE=config/sites.json
PUBLIC_BASE_URL=http://127.0.0.1:8199

TOOL_CALLING_RETRY_STRATEGY=focused_repair
TOOL_CALLING_INTERNAL_RETRY_MAX=2
TOOL_CALLING_MAX_TOOL_RESULT_CHARS=300000
TOOL_CALLING_ALLOW_MEDIA_POSTPROCESS=false
TOOL_CALLING_SANITIZE_ASSISTANT_CONTENT=true
TOOL_CALLING_PROMPT_PADDING_OBFUSCATE=false
TOOL_CALLING_PROMPT_PADDING_ENABLED=true

# Remote access is blocked by the hardened launcher unless all safeguards pass.
UWAPI_ALLOW_REMOTE=false

# Example for a future Tailscale/LAN setup:
# APP_HOST=0.0.0.0
# UWAPI_ALLOW_REMOTE=true
# AUTH_ENABLED=true
# AUTH_TOKEN=<random token of at least 32 characters>
# DASHBOARD_AUTH_ENABLED=true
# DASHBOARD_AUTH_TOKEN=<different random token of at least 32 characters>
# CORS_ENABLED=false
# APP_DEBUG=false
# CMD_ALLOW_UNSAFE_PYTHON_COMMANDS=false
